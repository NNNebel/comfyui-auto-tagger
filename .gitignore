# Node.js
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.idea/
.vscode/
*.swp
.DS_Store
.history/
tmp/

# Eagle Plugin specific resources
.Resources/
*.eagleplugin

# Build artifacts
dist/
build/
coverage/
coverage-summary.json

# Misc
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.next/
out/
*.sublime-project
*.sublime-workspace

# AI development files - NEVER commit these
AGENTS.md
CLAUDE.md
.claude/
.ai_docs/
docs/

# Test fixture files - developers should generate their own
tests/fixtures/*.png
tests/fixtures/*.webp
tests/fixtures/*.jpg
tests/fixtures/*.jpeg
# Bridge fixtures are committed as CI test data
!tests/fixtures/bridge-*.png
!tests/fixtures/bridge-*.webp
!tests/fixtures/bridge-*.jpg
!tests/fixtures/bridge-*.jpeg

# Test expected files - developers generate from their own samples
tests/expected/*.json
# Bridge fixture expected files are committed as cross-repo contract
# (eagle-metadata-bridge Python tests verify against these same values)
!tests/expected/bridge-*.json
!tests/expected/sample/
tests/expected/raw-metadata/

# Debug and test output files
debug-*.js
test-*.txt
test_*.txt
TEST_RULES.md